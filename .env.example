# Copy to .env (make db-up does it when .env is missing). Never commit .env.
# Every value below is a local, synthetic-data placeholder; no real credentials belong here.

# --- LLM profile local-qwen: LM Studio (Qwen3.6-35B-A3B) ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen/qwen3.6-35b-a3b

# --- LLM profile omniroute-free: OmniRoute, free-tier model combo (ADR-010) ---
# Synthetic data only. The combo must expose tool calling; confirm it before using the profile.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=changeme
OMNIROUTE_MODEL=auto/best-free

# --- Legacy database (Docker, host port 5434; LegacyBridge v1 uses 5433) ---
POSTGRES_PASSWORD=postgres_dev
LB_READER_PASSWORD=lb_reader_dev
LB_WRITER_PASSWORD=lb_writer_dev
# admin: schema owner, used only by the seed script. reader: SELECT only. writer: approved writes only.
LB_ADMIN_DSN=postgresql://postgres:postgres_dev@localhost:5434/legacy
LB_READER_DSN=postgresql://lb_reader:lb_reader_dev@localhost:5434/legacy
LB_WRITER_DSN=postgresql://lb_writer:lb_writer_dev@localhost:5434/legacy
