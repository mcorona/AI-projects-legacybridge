# Copy to .env (make db-up does it when .env is missing). Never commit .env.
# Every value below is a local, synthetic-data placeholder; no real credentials belong here.

# --- LLM profile local-qwen: LM Studio (Qwen3.6-35B-A3B) ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen/qwen3.6-35b-a3b

# --- LLM profile omniroute-free: OmniRoute, free-tier model combo (ADR-010) ---
# Synthetic data only. The combo must expose tool calling; confirm it before using the profile.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=changeme
# On 2026-10-08 the combos auto/best-free and auto/coding:free answered HTTP 500; a single free model
# worked: openrouter/nvidia/nemotron-3-ultra-550b-a55b:free (free models come and go; see ADR-003).
OMNIROUTE_MODEL=auto/best-free

# --- LLM profile bedrock-claude: Amazon Bedrock (Phase 7, ADR-014) ---
# Credentials never go in this file. On a laptop: `aws login --profile <name>` and name it below;
# in Lambda the function's role is used and AWS_PROFILE stays empty. Use an inference profile id.
BEDROCK_CHAT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_REGION=us-east-1
AWS_PROFILE=
# Larger models for the ceiling comparison (ADR-014 extension); optional
BEDROCK_SONNET_MODEL=us.anthropic.claude-sonnet-4-6
BEDROCK_OPUS_MODEL=us.anthropic.claude-opus-4-6-v1

# --- Legacy database (Docker, host port 5434; LegacyBridge v1 uses 5433) ---
POSTGRES_PASSWORD=postgres_dev
LB_READER_PASSWORD=lb_reader_dev
LB_WRITER_PASSWORD=lb_writer_dev
LB_PROPOSER_PASSWORD=lb_proposer_dev
# admin: schema owner, used only by the seed script. reader: SELECT only. writer: applies approved
# writes (Phase 4). proposer: can only queue requests in lb_ops.write_requests (ADR-005).
LB_ADMIN_DSN=postgresql://postgres:postgres_dev@localhost:5434/legacy
LB_READER_DSN=postgresql://lb_reader:lb_reader_dev@localhost:5434/legacy
LB_WRITER_DSN=postgresql://lb_writer:lb_writer_dev@localhost:5434/legacy
LB_PROPOSER_DSN=postgresql://lb_proposer:lb_proposer_dev@localhost:5434/legacy

# --- API (Phase 4) ---
# Bearer token for the approval endpoints (POST /approvals/{id}). Leave it empty to keep the
# approval API disabled: it fails closed. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LB_API_TOKEN=

# --- Tracing and SWAR (Phase 5) ---
# Off unless LB_TRACING=1. `make obs-up` starts Phoenix (http://localhost:6006) and the Collector.
LB_TRACING=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Attach prompts, SQL and rows to spans (truncated to 2000 chars). Synthetic data only.
LB_TRACE_CONTENT=
# Profile to rerun on when the early warning escalates (empty = no escalation: clarify or abstain)
LB_ESCALATION_PROFILE=
