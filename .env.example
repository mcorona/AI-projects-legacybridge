# Proveedor por defecto y cascada: local | omniroute | bedrock | cascade
LLM_PROVIDER=cascade

# --- LM Studio (local, $0) — MacBook M5 Pro 35 GB ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_CHAT_MODEL=qwen/qwen3.6-35b-a3b
LMSTUDIO_EMBED_MODEL=text-embedding-bge-m3
# Proveedor de embeddings del índice RAG: local | bedrock (cambiarlo exige `make index`)
EMBED_PROVIDER=local

# --- OmniRoute (gateway OpenAI-compatible, solo datos sintéticos) ---
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=changeme
OMNIROUTE_CHAT_MODEL=auto/best-free

# --- AWS Bedrock (escalamiento y evaluación final) ---
AWS_PROFILE=aif
AWS_REGION=us-east-1
BEDROCK_CHAT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# --- Base legacy (Docker, puerto 5433) ---
LB_DSN=postgresql://lb_ro:lb_ro@localhost:5433/legacy
LB_ADMIN_DSN=postgresql://postgres:postgres@localhost:5433/legacy
# Escritor del índice RAG (solo rag.chunks; ver db/legacy/03_rag.sql)
LB_RAG_DSN=postgresql://lb_rag_rw:lb_rag_rw@localhost:5433/legacy
# Bitácora de auditoría append-only (solo INSERT; ver db/legacy/04_ops.sql). Vacía = sin bitácora.
LB_AUDIT_DSN=postgresql://lb_audit:lb_audit@localhost:5433/legacy
# Propuestas de cambio (human-in-the-loop): el agente solo INSERTa; el revisor aprueba/rechaza. Nunca se ejecutan.
LB_PROPOSALS_DSN=postgresql://lb_proposals:lb_proposals@localhost:5433/legacy
LB_REVIEWER_DSN=postgresql://lb_reviewer:lb_reviewer@localhost:5433/legacy
# Guardrails opcionales: clasificador LLM de inyección y Amazon Bedrock Guardrails (ApplyGuardrail)
GUARDRAIL_LLM_CLASSIFIER=off
GUARDRAIL_CLASSIFIER_PROVIDER=local
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
